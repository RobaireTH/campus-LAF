# Postgres connection used by the app. On Neon use the pooled host (the one with -pooler in its name).
DATABASE_URL=

# Direct (non-pooled) connection used only by the Prisma CLI, for example prisma migrate deploy.
# Optional: when empty the CLI falls back to DATABASE_URL.
DIRECT_URL=

# Cloudflare R2 (S3 compatible) credentials for direct uploads and signed reads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=campus-laf-media

# Password of the seeded administrator admin@campuslaf.test, used by `npx prisma db seed`.
SEED_ADMIN_PASSWORD=
# Set to 1 together with the seed to replace the password of an administrator that already exists.
RESET_ADMIN_PASSWORD=

# Optional database for `npm run test:e2e`. Leave empty to use an isolated "e2e" schema inside DATABASE_URL.
E2E_DATABASE_URL=
